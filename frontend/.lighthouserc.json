{
  "ci": {
    "collect": {
      "url": ["http://localhost:8766/app/chat"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.90, "aggregationMethod": "median"}],
        "categories:accessibility": ["error", {"minScore": 0.95, "aggregationMethod": "median"}]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
