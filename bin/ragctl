def cmd_help(args: argparse.Namespace) -> int:
    """Comprehensive system guide for LLMs and humans."""
    if args.json:
        _emit(LLM_GUIDE, True)
        return 0
    print("=== ragctl — local hybrid Milvus RAG management CLI ===\n")
    print(LLM_GUIDE["system"], "\n")
    print("DATA FLOW")
    for step in LLM_GUIDE["data_flow"]:
        print(f"  • {step}")
    print()
    print("KEY PATHS")
    for k, v in LLM_GUIDE["key_paths"].items():
        print(f"  {k:<18} {v}")
    print()
    print("COMMANDS")
    for k, v in LLM_GUIDE["commands"].items():
        print(f"  {k:<26} {v}")
    print()
    print("LLM-FRIENDLY OUTPUT")
    print(f"  {LLM_GUIDE['json_flag']}")
    print()
    print("COMMON WORKFLOWS")
    for name, steps in LLM_GUIDE["common_workflows"].items():
        print(f"  [{name}]")
        for s in steps:
            print(f"    $ {s}")
        print()
    print("QUARANTINE RULES (algorithmic, no LLM)")
    for k, v in LLM_GUIDE["rules_quarantine"].items():
        print(f"  {k:<18} {v}")
    print()
    print("EXTRACTION RETRY CHAIN")
    for s in LLM_GUIDE["extraction_retry_chain"]:
        print(f"  • {s}")
    print()
    print("MODELS")
    for k, v in LLM_GUIDE["models"].items():
        print(f"  {k:<18} {v}")
    return 0


# ---------------------------------------------------------------------------
# query (proxy to bin/rag)
# ---------------------------------------------------------------------------
def cmd_query(args: argparse.Namespace) -> int:
    cmd = [str(ROOT / "bin" / "rag"), args.query]
    if args.notebook:
        cmd += ["--notebook", args.notebook]
    if args.json:
        cmd.append("--json")
    return _run(cmd).returncode


def cmd_ingest_deep_research(args: argparse.Namespace) -> int:
    """Stage + ingest a NotebookLM Deep Research brief. See scripts/ingest_deep_research.py."""
    cmd = [
        "uv", "run", "python", "-m", "scripts.ingest_deep_research",
        str(args.brief),
        "--query", args.query,
        "--notebook", args.notebook,
        "--collection", args.collection,
    ]
    return _run(cmd).returncode


def cmd_discover(args: argparse.Namespace) -> int:
    """Discover sources via NotebookLM Deep Research → ingest → delete notebook.

    Thin proxy. See scripts/discover_via_deep_research.py for the full flow.
    """
    cmd = [
        "uv", "run", "python", "-m", "scripts.discover_via_deep_research",
        "--query", args.query,
        "--collection", args.collection,
        "--mode", args.mode,
        "--timeout", str(args.timeout),
    ]
    if args.keep:
        cmd.append("--keep")
    return _run(cmd).returncode


def _positive_int(s: str) -> int:
    n = int(s)
    if n < 1:
        raise argparse.ArgumentTypeError(f"must be >= 1, got {n}")
    return n


# ---------------------------------------------------------------------------
# ingest-urls — fetch + ingest from an explicit URL list (non-NotebookLM path)
# ---------------------------------------------------------------------------
def cmd_ingest_urls(args: argparse.Namespace) -> int:
    """Fetch a hand-curated URL list, then parse + contextualize + ingest.

    Stage 1 (fetch) delegates to ``src.fetch.from_urls``. Stage 2+ runs
    per-doc directly against the URL-scoped doc dirs returned by fetch —
    bypasses ``run_pipeline`` to avoid the collection-wide doc enumeration
    that ``run_pipeline`` performs in parse-only mode. Audit (corpus-wide
    barrier) is intentionally skipped; run ``ragctl audit && ragctl apply``
    separately if cross-collection dedup is needed.
    """
    from src.fetch.from_urls import fetch_from_url_file  # noqa: PLC0415

    rc, fetched_dirs = fetch_from_url_file(args.urls, args.collection, args.notebook)
    if rc != 0:
        return rc
    if not fetched_dirs:
        print("No doc dirs to process.")
        return 0

    if args.dry_run:
        print(f"[dry-run] would process {len(fetched_dirs)} doc dirs:")
        for d in fetched_dirs:
            print(f"  {d}")
        return 0

    from src.pipeline.runner import (  # noqa: PLC0415
        RunLockHeldError,
        _acquire_run_lock,
        _release_run_lock,
    )

    try:
        run_lock_fd = _acquire_run_lock()
    except RunLockHeldError as exc:
        print(f"REFUSING TO RUN: {exc}")
        return 2
    atexit_register_release = False
    try:
        import atexit  # noqa: PLC0415
        atexit.register(_release_run_lock, run_lock_fd)
        atexit_register_release = True

        from google import genai  # noqa: PLC0415

        from src import config  # noqa: PLC0415
        from src.ingest.chunker import _get_encoder  # noqa: PLC0415
        from src.ingest.contextualize_corpus import contextualize_file  # noqa: PLC0415
        from src.ingest.ingest import _build_gemini_client, ingest_file  # noqa: PLC0415
        from src.ingest.storage import _open_parents_db  # noqa: PLC0415
        from src.milvus_client import ensure_collection, ensure_partition  # noqa: PLC0415
        from src.pdf_parsers import mineru_daemon  # noqa: PLC0415
        from src.pdf_parsers.mineru import parse_pdf  # noqa: PLC0415

        config.validate_api_key()
        ensure_collection(args.collection)
        ensure_partition(args.collection, args.notebook)
        gemini_client: genai.Client = _build_gemini_client()
        enc = _get_encoder()
        db_conn = _open_parents_db()

        # Start the MinerU pipeline daemon up-front if any PDF needs parsing.
        # parse_pipeline_only now requires the daemon (the CLI-subprocess fall-
        # back was removed because it bypassed the gpu-broker's claim and OOM'd
        # whenever the reranker held VRAM). Acquire of the broker claim happens
        # inside start_pipeline_daemon and blocks until a higher-priority holder
        # (e.g. the reranker) releases.
        needs_mineru = any(
            (d / "source.pdf").exists() and not (d / "content_list.json").exists()
            for d in fetched_dirs
        )
        mineru_started = False
        if needs_mineru:
            try:
                mineru_daemon.start_pipeline_daemon()
                mineru_started = True
            except Exception as exc:
                print(f"REFUSING TO RUN: cannot start MinerU daemon: "
                      f"{type(exc).__name__}: {exc}")
                db_conn.close()
                return 2

        try:
            n_ok = 0
            n_skip = 0
            n_fail = 0
            for i, doc_dir in enumerate(fetched_dirs, 1):
                print(f"\n[{i}/{len(fetched_dirs)}] {doc_dir.name}")

                pdf = doc_dir / "source.pdf"
                sidecar = doc_dir / "content_list.json"
                if pdf.exists() and not sidecar.exists():
                    print(f"  parse: MinerU on {pdf.name}")
                    try:
                        parse_pdf(pdf)
                    except Exception as exc:
                        print(f"  parse FAIL: {type(exc).__name__}: {exc}")
                        n_fail += 1
                        continue

                for txt_name in ("nlm.txt", "pdf.txt", "web.txt"):
                    txt = doc_dir / txt_name
                    ctx = doc_dir / f"{txt_name}.ctx.json"
                    if txt.exists() and not ctx.exists():
                        try:
                            contextualize_file(txt)
                        except Exception as exc:
                            print(f"  contextualize {txt_name} FAIL: {type(exc).__name__}: {exc}")

                if not sidecar.exists():
                    print("  no content_list.json — skip ingest")
                    n_skip += 1
                    continue

                try:
                    result = ingest_file(
                        path=sidecar,
                        notebook=args.notebook,
                        collection=args.collection,
                        gemini_client=gemini_client,
                        db_conn=db_conn,
                        enc=enc,
                    )
                    if result.get("skipped"):
                        print(f"  ingest skipped: {result.get('reason')}")
                        n_skip += 1
                    else:
                        print(f"  ingest done: {result.get('n_parents')} parents, "
                              f"{result.get('n_children')} children")
                        n_ok += 1
                except Exception as exc:
                    print(f"  ingest FAIL: {type(exc).__name__}: {exc}")
                    n_fail += 1
        finally:
            db_conn.close()
            if mineru_started:
                try:
                    mineru_daemon.stop_pipeline_daemon()
                except Exception as exc:
                    print(f"warning: stop_pipeline_daemon raised: "
                          f"{type(exc).__name__}: {exc}")

        print(f"\n=== ingest-urls done: {n_ok} ingested, {n_skip} skipped, {n_fail} failed ===")
        return 0 if n_fail == 0 else 1
    finally:
        if not atexit_register_release:
            _release_run_lock(run_lock_fd)


# ---------------------------------------------------------------------------
# run — pipelined per-collection orchestrator
# ---------------------------------------------------------------------------
def cmd_run(args: argparse.Namespace) -> int:
    """Thin shim over src.pipeline.runner.run_pipeline().

    Stage 1 (fetch) requires ``--notebooks <UUID>+``; sources land in
    ``sources/<collection>/<slug>/``. Stage 2 (parse → audit → contextualize →
    ingest) iterates over the existing archive when ``--notebooks`` is omitted.
    """
    notebooks: list[dict[str, str]] = []
    if args.notebooks:
        if "fetch" not in (args.stages or orchestrate.ALL_STAGES) and args.stages:
            print("--notebooks is only meaningful when fetch is in --stages",
                  file=sys.stderr)
            return 2
        for nb_id in args.notebooks:
            notebooks.append({"id": nb_id, "collection": args.collection})
    else:
        # Parse-only / audit-only / ingest-only: one entry per collection so
        # the runner's per-collection bookkeeping has at least one row.
        notebooks.append({"id": "", "collection": args.collection})

    stages = orchestrate.select_stages(args)

    if args.notebooks is None and "fetch" in stages:
        # No UUIDs provided but fetch was selected — drop fetch silently so
        # `ragctl run --collection trading` is a parse+audit+contextualize+ingest
        # over the existing archive without needing --skip-stages fetch.
        stages = [s for s in stages if s != "fetch"]

    from src.pipeline.runner import run_pipeline  # noqa: PLC0415

    parse_workers = args.parse_workers if hasattr(args, "parse_workers") else None
    return run_pipeline(
        notebooks,
        stages,
        root=ROOT,
        parallel=args.parallel,
        parse_workers=parse_workers,
        no_cffi=args.no_cffi,
        dry_run=args.dry_run,
        retry_failed=getattr(args, "retry_failed", False),
    )


# ---------------------------------------------------------------------------
# notebooks — list known NotebookLM IDs from CLAUDE.md table
# ---------------------------------------------------------------------------
def cmd_pipeline_status(args: argparse.Namespace) -> int:
    """Show latest stage event per slug from pipeline_status.jsonl."""
    from src.pipeline.pipeline_log import latest_per_slug, read_status_lines  # noqa: PLC0415

    if args.history:
        # Print full history of recent events (newest first), capped.
        events = read_status_lines(limit=args.history)
        if args.json:
            _emit({"events": events}, True)
        else:
            if not events:
                print("(no pipeline events yet)")
                return 0
            print(f"{'ts':<20} {'slug':<32} {'stage':<14} {'action':<6} {'ok':>4} {'fail':>4} {'elapsed':>9}")
            for e in events:
                ts = e.get("ts", "")[:19]
                slug = e.get("slug", "?")[:32]
                stage = e.get("stage", "?")[:14]
                action = e.get("action", "?")[:6]
                n_ok = e.get("n_ok", 0)
                n_fail = e.get("n_fail", 0)
                el = e.get("elapsed_s", 0)
                print(f"{ts:<20} {slug:<32} {stage:<14} {action:<6} {n_ok:>4} {n_fail:>4} {el:>8.1f}s")
        return 0

    latest = latest_per_slug()
    if args.json:
        _emit({"slugs": latest}, True)
    else:
        if not latest:
            print("(no pipeline events yet)")
            return 0
        print(f"{'slug':<32} {'stage':<14} {'action':<6} {'ok':>4} {'fail':>4} {'elapsed':>9}  ts")
        for slug, e in sorted(latest.items()):
            stage = e.get("stage", "?")[:14]
            action = e.get("action", "?")[:6]
            n_ok = e.get("n_ok", 0)
            n_fail = e.get("n_fail", 0)
            el = e.get("elapsed_s", 0)
            ts = e.get("ts", "")[:19]
            print(f"{slug:<32} {stage:<14} {action:<6} {n_ok:>4} {n_fail:>4} {el:>8.1f}s  {ts}")
    return 0


def cmd_pipeline_tail(args: argparse.Namespace) -> int:
    """Follow per-stage JSONL files for a slug live (like tail -F)."""

    from src.pipeline.pipeline_log import LOGS_DIR, STAGES, stage_log_path  # noqa: PLC0415

    slug = args.slug
    stages = [args.stage] if args.stage else list(STAGES)
    paths = [stage_log_path(slug, s) for s in stages]
    paths = [p for p in paths if p.exists()] if not args.wait else paths

    if not paths:
        print(f"No log files found for slug={slug!r}. Existing logs in {LOGS_DIR}:")
        for p in sorted(LOGS_DIR.glob(f"{slug}_*.jsonl")):
            print(f"  {p.name}")
        return 1

    # Open all at end of file; tail forever.
    handles = {}
    for p in paths:
        if p.exists():
            f = p.open("r", encoding="utf-8")
            f.seek(0, 2)  # end
            handles[p] = f

    print(f"Tailing {len(handles)} log file(s) for slug={slug!r}. Ctrl-C to stop.")
    try:
        while True:
            had_any = False
            # Pick up new files matching the slug (when --wait is set)
            if args.wait:
                for p in paths:
                    if p not in handles and p.exists():
                        f = p.open("r", encoding="utf-8")
                        handles[p] = f  # start from beginning for newly-appearing files
            for p, f in list(handles.items()):
                line = f.readline()
                while line:
                    had_any = True
                    line = line.rstrip("\n")
                    try:
                        rec = json.loads(line)
                        item = rec.get("item", "?")
                        status = rec.get("status", "?")
                        stage = rec.get("stage", p.stem.split("_", 1)[1] if "_" in p.stem else "?")
                        el = rec.get("elapsed_s", "")
                        el_str = f" ({el}s)" if el != "" else ""
                        extra = ""
                        if status == "fail":
                            extra = f"  reason={rec.get('reason', '?')}"
                        print(f"  [{stage:<14}] {status:<5} {item}{el_str}{extra}", flush=True)
                    except json.JSONDecodeError:
                        print(f"  [{p.name}] {line}")
                    line = f.readline()
            if not had_any:
                time.sleep(1.0)
    except KeyboardInterrupt:
        print("\n(stopped)")
        return 0


def cmd_metadata_backfill(args: argparse.Namespace) -> int:
    """Run rule-based metadata extraction across all sources."""
    cmd = ["uv", "run", "python", "-m", "src.fetch.metadata", "--all"]
    if args.dry_run:
        cmd.append("--dry-run")
    return _run(cmd).returncode


# ---------------------------------------------------------------------------
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="ragctl", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("help", help="comprehensive system guide (LLM-friendly with --json)")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_help)

    s = sub.add_parser("status", help="corpus + Milvus snapshot")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("audit", help="filename + dedup audits + build cleanup manifest")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_audit)

    s = sub.add_parser("apply", help="apply cleanup manifest (move to _quarantine_*/)")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(func=cmd_apply)

    s = sub.add_parser("query", help="run a query (proxy to bin/rag)")
    s.add_argument("query")
    s.add_argument("--notebook", default=None)
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_query)

    s = sub.add_parser("ingest-deep-research",
                       help="stage + ingest a NotebookLM Deep Research brief (Phase 2.7)")
    s.add_argument("brief", help="path to the brief markdown file")
    s.add_argument("--query", required=True,
                   help="the original Deep Research question")
    s.add_argument("--notebook", default="research_briefs",
                   help="partition tag (default: research_briefs)")
    s.add_argument("--collection", default="trading",
                   help="Milvus collection (default: trading)")
    s.set_defaults(func=cmd_ingest_deep_research)

    s = sub.add_parser("discover",
                       help="discover sources via NotebookLM Deep Research, "
                            "fetch + ingest, then delete the notebook")
    s.add_argument("--query", required=True,
                   help="the Deep Research question to send to NotebookLM")
    s.add_argument("--collection", required=True,
                   choices=("trading", "ecology", "notes", "system", "security"),
                   help="Milvus collection that gets the new chunks")
    s.add_argument("--mode", default="deep", choices=("fast", "deep"),
                   help="NotebookLM search mode (default: deep)")
    s.add_argument("--timeout", type=int, default=1800,
                   help="seconds to wait for research to finish (default: 1800)")
    s.add_argument("--keep", action="store_true",
                   help="don't delete the NotebookLM notebook on success")
    s.set_defaults(func=cmd_discover)

    s = sub.add_parser("metadata-backfill",
                       help="run rule-based metadata extraction across all sources "
                       "(arxiv_id, doi, authors, quality counts)")
    s.add_argument("--dry-run", action="store_true", help="print what would change, don't write")
    s.set_defaults(func=cmd_metadata_backfill)

    s = sub.add_parser(
        "ingest-urls",
        help="fetch + ingest a hand-curated URL list (non-NotebookLM path)",
    )
    s.add_argument("urls", type=Path,
                   help="File with one URL per line. `title || url` form supported.")
    s.add_argument("--collection", required=True,
                   choices=orchestrate.VALID_COLLECTIONS,
                   help="target collection root under sources/. Required.")
    s.add_argument("--notebook", required=True,
                   help="partition tag for log file naming and ingest routing.")
    s.add_argument("--parallel", type=_positive_int, default=5,
                   help="number of fetch workers (default: 5).")
    s.add_argument("--parse-workers", type=_positive_int, default=None,
                   help="number of parse workers (default: same as --parallel).")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(func=cmd_ingest_urls)

    s = sub.add_parser(
        "run",
        help="full pipeline: [fetch UUIDs →] parse → audit → contextualize → ingest",
    )
    s.add_argument("--collection", required=True,
                   choices=orchestrate.VALID_COLLECTIONS,
                   help="target collection root under sources/. Required.")
    s.add_argument("--notebooks", nargs="+", default=None,
                   help="NotebookLM UUIDs to fetch. Stage-1 only; omit for "
                        "parse + audit + contextualize + ingest over the existing "
                        "archive at sources/<collection>/.")
    s.add_argument("--stages", nargs="+", default=None,
                   help=f"subset of {{{','.join(orchestrate.ALL_STAGES)},all}} (default: all)")
    s.add_argument("--skip-stages", nargs="+", default=None,
                   help="inverse of --stages (mutually exclusive)")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--parallel", type=_positive_int, default=5,
                   help="number of fetch workers (also parse workers if --parse-workers "
                        "not set; default: 5, must be >= 1)")
    s.add_argument("--parse-workers", type=_positive_int, default=None,
                   help="number of parse workers. MinerU's daemon currently limits "
                        "concurrent inference to ~3 on this GPU. "
                        "Setting this higher just queues at the daemon's HTTP layer.")
    s.add_argument("--no-cffi", action="store_true",
                   help="passed through to fetch (disables curl_cffi)")
    s.add_argument("--retry-failed", action="store_true",
                   help="filter to sources whose last fetch produced no ok web.txt or "
                        "source.pdf; evicts their URL-cache entries so the spider writes fresh")
    s.add_argument("--unbounded", action="store_true",
                   help="skip the implicit cgroup wrap (Linux only). "
                        "Use for CI without sudo, or to override the memory ceiling.")
    s.set_defaults(func=cmd_run)

    s = sub.add_parser("pipeline-status",
                       help="show latest pipeline stage event per slug")
    s.add_argument("--history", type=int, default=None,
                   help="show N most recent events instead of latest-per-slug")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_pipeline_status)

    s = sub.add_parser("pipeline-tail",
                       help="follow per-stage JSONL files for a slug (like tail -F)")
    s.add_argument("slug")
    s.add_argument("--stage", choices=("fetch","parse_pipeline","parse_vlm","stage","audit",
                                       "manifest","apply","contextualize","ingest"),
                   default=None,
                   help="restrict to one stage (default: all)")
    s.add_argument("--wait", action="store_true",
                   help="wait for files that don't exist yet (poll for creation)")
    s.set_defaults(func=cmd_pipeline_tail)

    qsub = sub.add_parser("quarantine", help="inspect/restore quarantined files").add_subparsers(
        dest="qcmd", required=True
    )
    s = qsub.add_parser("list")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_quarantine_list)
    s = qsub.add_parser("restore")
    s.add_argument("path")
    s.set_defaults(func=cmd_quarantine_restore)
    s = qsub.add_parser("show", help="show sidecar for one crasher quarantine")
    s.add_argument("collection")
    s.add_argument("slug")
    s.set_defaults(func=cmd_quarantine_show)
    s = qsub.add_parser(
        "unquarantine",
        help="move a crasher-quarantined slug back to active sources",
    )
    s.add_argument("collection")
    s.add_argument("slug")
    s.set_defaults(func=cmd_quarantine_unquarantine)

    return p


def main() -> int:
    _maybe_reexec_bounded(sys.argv)
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
