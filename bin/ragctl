#!/usr/bin/env -S uv run python
"""ragctl — single-entry CLI to manage the local hybrid Milvus RAG.

Subcommands cover the full lifecycle: fetch → parse → audit → contextualize →
ingest → query, plus inspection commands (status, quarantine).

Every subcommand supports `--json` for machine-readable output (LLM-friendly).

Usage:
    ragctl status [--json]
    ragctl run --collection <coll> [--notebooks <UUID>+] [--stages ...]
    ragctl audit [--json]                         # corpus-wide audit + manifest
    ragctl apply [--dry-run]                      # apply cleanup manifest
    ragctl query "<text>" [--notebook X] [--json]
    ragctl quarantine list [--json]
    ragctl quarantine restore <path>

The on-disk archive lives at ``sources/<collection>/<slug>/``. There is no
notebook-level addressability after fetch; once a doc lands in the archive
its NLM UUID is a discardable batch handle.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from src.pipeline import orchestrate  # noqa: E402


def _run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    """Run a subprocess with the project root as CWD. Streams to terminal by default."""
    return subprocess.run(cmd, cwd=ROOT, check=False, **kw)


# ---------------------------------------------------------------------------
# Memory cgroup self-bound for `ragctl run`
# ---------------------------------------------------------------------------
#
# Bound parser memory so a failed parse cannot exhaust the whole host.
#
# Eligibility (all required):
#   - subcommand == "run"
#   - not --dry-run (no need to bound a no-op)
#   - not --unbounded (escape hatch, e.g. CI without sudo)
#   - Linux (Mac dev path runs other subcommands inline)
#   - not already inside a memory-limited cgroup
#   - systemd-run + sudo available
#
# Tunable via env: RAG_MEM_HIGH (default 24G), RAG_MEM_MAX (default 28G).

_RAG_BOUND_ENV = "RAG_BOUNDED"   # sentinel set when re-exec'd, prevents recursion
_RAG_MEM_HIGH = os.environ.get("RAG_MEM_HIGH", "24G")
_RAG_MEM_MAX = os.environ.get("RAG_MEM_MAX", "28G")


def _already_bounded() -> bool:
    """True if our current cgroup already has a finite memory.max.

    Prevents recursion when re-exec'd inside the scope (sentinel env var
    is the primary guard; this is defence in depth for the case where the
    env got stripped but we're definitely under a limit already).
    """
    try:
        cg_line = Path("/proc/self/cgroup").read_text().strip()
        cg_path = cg_line.split(":")[-1]
        max_file = Path(f"/sys/fs/cgroup{cg_path}/memory.max")
        if not max_file.exists():
            return False
        return max_file.read_text().strip() != "max"
    except OSError:
        return False


def _maybe_reexec_bounded(argv: list[str]) -> None:
    """If `argv` is a `ragctl run` invocation that should be cgroup-bounded,
    re-exec self under sudo systemd-run --scope and never return.

    Returns (does nothing) when not eligible.
    """
    if os.environ.get(_RAG_BOUND_ENV) == "1":
        return                                    # already inside the scope
    if len(argv) < 2 or argv[1] != "run":
        return                                    # only `run` is bounded
    if "--dry-run" in argv or "--unbounded" in argv:
        return
    if sys.platform != "linux":
        return                                    # Mac dev / CI macOS
    if _already_bounded():
        return
    if shutil.which("systemd-run") is None or shutil.which("sudo") is None:
        return

    # Strip --unbounded if present (it isn't, given the check above, but
    # keep argv clean) and re-exec under the scope.
    inner = [a for a in argv if a != "--unbounded"]
    user = os.environ.get("USER") or str(os.getuid())
    home = os.environ.get("HOME", "")
    path = os.environ.get("PATH", "")
    # Ensure ~/.local/bin (uv) resolves under the scope's reset PATH.
    if home and f"{home}/.local/bin" not in path.split(":"):
        path = f"{home}/.local/bin:{path}"
    cmd = [
        "sudo", "systemd-run", "--scope", "--quiet",
        f"-pMemoryHigh={_RAG_MEM_HIGH}",
        f"-pMemoryMax={_RAG_MEM_MAX}",
        "-pMemorySwapMax=infinity",
        f"--uid={user}",
        f"--working-directory={Path.cwd()}",
        f"--setenv={_RAG_BOUND_ENV}=1",
        f"--setenv=HOME={home}",
        f"--setenv=PATH={path}",
        *inner,
    ]
    print(
        f"ragctl: re-exec under cgroup (MemoryHigh={_RAG_MEM_HIGH}, "
        f"MemoryMax={_RAG_MEM_MAX}); pass --unbounded to disable",
        file=sys.stderr,
    )
    os.execvp(cmd[0], cmd)


def _emit(data: dict, as_json: bool, lines: list[str] | None = None) -> None:
    """Print machine-readable JSON or human-friendly text per --json flag."""
    if as_json:
        print(json.dumps(data, indent=2, default=str))
    else:
        if lines:
            for line in lines:
                print(line)
        else:
            for k, v in data.items():
                print(f"{k}: {v}")


# ---------------------------------------------------------------------------
# status — corpus + milvus snapshot
# ---------------------------------------------------------------------------
def cmd_status(args: argparse.Namespace) -> int:
    sources = ROOT / "sources"
    docs_per_collection: dict[str, int] = {}
    if sources.exists():
        for coll_dir in sorted(sources.iterdir()):
            if not coll_dir.is_dir() or coll_dir.name.startswith("_"):
                continue
            docs_per_collection[coll_dir.name] = sum(
                1 for d in coll_dir.iterdir()
                if d.is_dir() and not d.name.startswith("_")
            )
    n_quarantine_p = (
        sum(1 for _ in (sources / "_quarantine_poisoned").rglob("*.txt"))
        if sources.exists() else 0
    )
    n_quarantine_d = (
        sum(1 for _ in (sources / "_quarantine_dupes").rglob("*.txt"))
        if sources.exists() else 0
    )
    n_sidecars = sum(1 for _ in sources.rglob("*.ctx.json")) if sources.exists() else 0

    milvus: dict = {}
    try:
        from src.milvus_client import get_client  # noqa: PLC0415

        client = get_client()
        for name in client.list_collections():
            stats = client.get_collection_stats(collection_name=name)
            milvus[name] = {"entities": int(stats.get("row_count", 0))}
    except Exception as e:
        milvus = {"error": f"{type(e).__name__}: {e}"}

    data = {
        "docs_per_collection": docs_per_collection,
        "docs_total": sum(docs_per_collection.values()),
        "quarantine_poisoned": n_quarantine_p,
        "quarantine_dupes": n_quarantine_d,
        "context_sidecars": n_sidecars,
        "milvus": milvus,
    }

    if args.json:
        _emit(data, True)
    else:
        print("=== RAG corpus status ===")
        print(f"  collections: {len(docs_per_collection)} "
              f"({sum(docs_per_collection.values())} doc dirs)")
        for coll, n in sorted(docs_per_collection.items(), key=lambda x: -x[1]):
            print(f"    {coll:<28} {n:>5d}")
        print(f"  quarantine_poisoned: {n_quarantine_p}")
        print(f"  quarantine_dupes:    {n_quarantine_d}")
        print(f"  context sidecars:    {n_sidecars}")
        print()
        print("=== Milvus ===")
        for k, v in milvus.items():
            print(f"  {k}: {v}")
    return 0


# ---------------------------------------------------------------------------
# audit / apply
# ---------------------------------------------------------------------------
def cmd_audit(args: argparse.Namespace) -> int:
    """Run filename-content + cross-partition dedup audits, then build manifest."""
    for mod in ["src.cleanup.filename_content_match_audit", "src.cleanup.cross_partition_dedup_audit", "src.cleanup.build_cleanup_manifest"]:
        result = _run(["uv", "run", "python", "-m", mod],
                      capture_output=args.json)
        if result.returncode != 0:
            return result.returncode

    manifest_path = ROOT / "logs" / "cleanup_manifest.json"
    if not manifest_path.exists():
        return 1
    manifest = json.loads(manifest_path.read_text())

    if args.json:
        _emit({"summary": manifest["summary"]}, True)
    else:
        s = manifest["summary"]
        print(f"\n=== cleanup manifest ({manifest_path.name}) ===")
        print(f"  poisoned:   {s['n_quarantine_poisoned']}")
        print(f"  dupes:      {s['n_quarantine_dupes']}")
        print(f"  canonicals: {s['n_canonical_groups']}")
    return 0


def cmd_apply(args: argparse.Namespace) -> int:
    cmd = ["uv", "run", "python", "-m", "src.cleanup.apply_cleanup_manifest"]
    if args.dry_run:
        cmd.append("--dry-run")
    return _run(cmd).returncode


# ---------------------------------------------------------------------------
# quarantine
# ---------------------------------------------------------------------------
def cmd_quarantine_list(args: argparse.Namespace) -> int:
    from src.pipeline.quarantine import list_quarantined  # noqa: PLC0415

    pois = sorted((ROOT / "sources" / "_quarantine_poisoned").rglob("*.txt"))
    dupes = sorted((ROOT / "sources" / "_quarantine_dupes").rglob("*.txt"))
    crashers = list_quarantined(ROOT / "sources")

    data = {
        "poisoned": [str(p.relative_to(ROOT)) for p in pois],
        "dupes": [str(p.relative_to(ROOT)) for p in dupes],
        "crashers": crashers,
        "totals": {
            "poisoned": len(pois),
            "dupes": len(dupes),
            "crashers": len(crashers),
        },
    }
    if args.json:
        _emit(data, True)
    else:
        print(f"=== quarantine_poisoned ({len(pois)}) ===")
        for p in pois:
            print(f"  {p.relative_to(ROOT)}")
        print(f"\n=== quarantine_dupes ({len(dupes)}) ===")
        for p in dupes:
            print(f"  {p.relative_to(ROOT)}")
        print(f"\n=== _quarantine (crashers) ({len(crashers)}) ===")
        for r in crashers:
            reason = r.get("reason", "?")
            deaths = r.get("deaths_observed", "?")
            ts = r.get("quarantined_at", "")
            print(f"  {r['collection']}/{r['slug']}  "
                  f"reason={reason} deaths={deaths} at={ts}")
    return 0


def cmd_quarantine_show(args: argparse.Namespace) -> int:
    """Print the sidecar contents for one quarantined slug."""
    from src.pipeline.quarantine import list_quarantined  # noqa: PLC0415

    rows = list_quarantined(ROOT / "sources")
    match = next(
        (r for r in rows
         if r["collection"] == args.collection and r["slug"] == args.slug),
        None,
    )
    if match is None:
        print(
            f"not under crasher quarantine: {args.collection}/{args.slug}",
            file=sys.stderr,
        )
        return 1
    _emit(match, True)
    return 0


def cmd_quarantine_unquarantine(args: argparse.Namespace) -> int:
    """Move a crasher-quarantined slug back to active sources."""
    from src.pipeline.quarantine import unquarantine_source  # noqa: PLC0415

    try:
        target = unquarantine_source(
            sources_root=ROOT / "sources",
            collection=args.collection,
            slug=args.slug,
        )
    except FileNotFoundError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    print(f"unquarantined: {target.relative_to(ROOT)}")
    return 0


def cmd_quarantine_restore(args: argparse.Namespace) -> int:
    """Move a quarantined file back into its collection dir (reverses one apply).

    The expected path layout is
    ``sources/_quarantine_{poisoned,dupes}/<collection>/<slug>/<leaf>``;
    the file is restored to ``sources/<collection>/<slug>/<leaf>``.
    """
    p = Path(args.path)
    if not p.is_absolute():
        p = ROOT / p
    if not p.exists():
        print(f"not found: {p}", file=sys.stderr)
        return 1
    parts = p.relative_to(ROOT / "sources").parts
    if len(parts) < 3 or parts[0] not in ("_quarantine_poisoned", "_quarantine_dupes"):
        print(f"not in a quarantine bucket: {p}", file=sys.stderr)
        return 1
    target = ROOT / "sources" / parts[1] / "/".join(parts[2:])
    target.parent.mkdir(parents=True, exist_ok=True)
    p.rename(target)
    print(f"restored: {target.relative_to(ROOT)}")
    return 0


